# ==============================================================================
# RiseTogetherBD Frontend Environment Configuration
# ==============================================================================

# Public site URL (used for metadata, SEO, and canonical links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend API base URL (used by browser client-side fetch requests)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# CDN URL for uploaded images & assets (Cloudflare R2 or backend static server)
NEXT_PUBLIC_CDN_URL=http://localhost:5000

# Backend API endpoint for server-side Next.js rewrites and SSR requests
BACKEND_BASE_URL=http://localhost:5000/api/v1

# Container Port & Host configuration (defaults to 3000 and 0.0.0.0 in Docker)
PORT=3000
HOSTNAME=0.0.0.0
